# Google Apps Script URL (tu script desplegado en Google)
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
# Mantener en false hasta cerrar la sincronizacion completa con Google Sheets.
VITE_ENABLE_GOOGLE_SYNC=false

# DeepSeek API Key (https://platform.deepseek.com)
VITE_DEEPSEEK_API_KEY=sk-your-deepseek-key

# Ollama URL (solo para uso local en ordenador)
VITE_OLLAMA_URL=http://localhost:11434
# Opcional. Si se omite, la app usa el primer modelo local disponible.
VITE_OLLAMA_MODEL=
